<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  No App Sandbox: the notarized download from GitHub replaces itself when it
  updates (lib/core/updater_install.dart), which a sandboxed app cannot do.
  Bluetooth, serial ports, the network and files need no entitlement outside
  the sandbox; the hardened runtime still applies. A Mac App Store build would
  need its own sandboxed entitlements and no updater.
-->
<plist version="1.0">
<dict/>
</plist>

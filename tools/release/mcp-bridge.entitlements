<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  koebelt-dash-mcp, the MCP bridge next to the app's executable: a compiled
  Dart program maps its code at run time, which the hardened runtime only
  allows with this entitlement. The app itself does not get it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
